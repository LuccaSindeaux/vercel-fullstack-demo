# =========================================================
# .gitignore — Next.js + TypeScript + Vercel
# =========================================================

# ---------- Dependências ----------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
bower_components/
jspm_packages/

# ---------- Build / saída do Next.js ----------
/.next/
/out/
/build
/dist
next-env.d.ts

# ---------- Caches ----------
.cache/
.turbo/
.swc/
.eslintcache
.stylelintcache
.parcel-cache/
*.tsbuildinfo

# ---------- Testes e cobertura ----------
/coverage
/.nyc_output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ---------- Variáveis de ambiente (NUNCA commitar segredos) ----------
.env
.env.*
!.env.example

# ---------- Vercel ----------
.vercel

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ---------- Certificados e chaves ----------
*.pem
*.key
*.crt
*.p12
*.pfx

# ---------- Sistema operacional ----------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Editores e IDEs ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ---------- Ferramentas locais de IA ----------
.claude/settings.local.json

# ---------- Diversos ----------
*.tgz
*.tmp
*.bak

# ---------- Arquivos de instrução (não fazem parte do projeto) ----------
PROMPT_BUILD.md
instructions.md
AGENTS.md
